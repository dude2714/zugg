  </requires>
  <extension point="xbmc.addon.repository" name="Fen Jr Repo">
    <dir>
      <info compressed="false">https://raw.githubusercontent.com/dude2714/zugg/master/repo_fenjr/addons.xml</info>
      <checksum>https://raw.githubusercontent.com/dude2714/zugg/master/repo_fenjr/addons.xml.md5</checksum>
